# Copy to .env and edit locally. Never commit your .env file.
# All paths may be relative to the repository root.
ALFWORLD_DATA=data/alfworld
WEBSHOP_ROOT=external/webshop

# Optional separate Python executables for benchmark workers.
ALFWORLD_PYTHON=python
WEBSHOP_PYTHON=python
SCIENCEWORLD_PYTHON=python

# Local OpenAI-compatible inference service; start vLLM separately.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8000/v1
QWEN3_4B_PATH=models/Qwen3-4B
QWEN3_8B_PATH=models/Qwen3-8B
QWEN3_14B_PATH=models/Qwen3-14B
QWEN3_32B_PATH=models/Qwen3-32B

# OpenAI-compatible API endpoint and credentials.
API_BASE_URL=
API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_MODEL=gemini-2.5-flash
